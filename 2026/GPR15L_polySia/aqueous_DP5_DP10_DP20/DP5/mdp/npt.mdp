
; VARIOUS PREPROCESSING OPTIONS 
title                   = NVT EQUI FOR CHARMM36 100 ps T=300 K



; RUN CONTROL PARAMETERS 
integrator              = md        ; leap-frog integrator
nsteps                  = 50000     ; 2 * 100000 = 100 ps
dt                      = 0.002     ; 2 fs

; OUTPUT CONTROL
nstxout                 = 500       ; save coordinates every 1.0 ps
nstvout                 = 500       ; save velocities every 1.0 ps
nstenergy               = 500       ; save energies every 1.0 ps
nstlog                  = 500       ; update log file every 1.0 ps

; CONSTRAINS 
continuation            = yes        ; first dynamics run
constraint_algorithm    = lincs     ; holonomic constraints 
constraints             = h-bonds   ; bonds involving H are constrained
lincs_iter              = 1         ; accuracy of LINCS
lincs_order             = 4         ; also related to accuracy
nstcomm                 = 100
comm_mode               = linear
;comm_grps               = 


; NONBONDEND INTERACTIONS 
cutoff-scheme           = Verlet    ; Buffered neighbor searching
ns_type                 = grid      ; search neighboring grid cells
nstlist                 = 20        ; 20 fs, largely irrelevant with Verlet
rcoulomb                = 1.2       ; short-range electrostatic cutoff (in nm)
rvdw                    = 1.2       ; short-range van der Waals cutoff (in nm)
DispCorr                = EnerPres  ; account for cut-off vdW scheme
vdw-modifier            = Force-switch
vdwtype                 = Cut-off
rvdw_switch             = 1.0

; ELECTROSTATIC
coulombtype             = PME       ; Particle Mesh Ewald for long-range electrostatics

; TEMPERATURE CONTROLL
tcoupl                  = Nose-Hoover             ; modified Berendsen thermostat
tc-grps                 = ROH_8SA_0SA Protein Water_and_ions   ; two coupling groups - more accurate
tau_t                   = 2.0 2.0 2.0                 ; time constant, in ps
ref_t                   = 300 300 300                 ; reference temperature, one for each group, in K

; PRESSURE CONTROL
pcoupl                  = Parrinello-Rahman     ; Pressure coupling on in NPT
pcoupltype              = isotropic             ; uniform scaling of box vectors
tau_p                   = 5.0                   ; time constant, in ps
ref_p                   = 1.0                   ; reference pressure, in bar
compressibility         = 4.5e-5                ; isothermal compressibility of water, bar^-1
