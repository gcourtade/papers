source leaprc.GLYCAM_06j-1
source leaprc.protein.ff14SB   
source leaprc.lipid21

main = sequence { VVA 3LB 0SA }
branch = sequence { 4YB 3LB 0SA }

glycan = combine { main branch }
bond glycan.1.O6 glycan.4.C1

impose glycan {2} { {C1 O3 C3 H3 -33} }
impose glycan {3} { {C2 O3 C3 H3 -25} }
impose glycan {4} { {C1 O6 C6 H61 0} }
impose glycan {4} { {H1 C1 O6 C6  41} }
impose glycan {5} { {C1 O4 C4 H4 -15} }
impose glycan {6} { {C2 O3 C3 H3 -50} }

translate glycan {-20 -15 -50}
savepdb glycan glycan.pdb

prot = loadpdb clean_bilayer_RL_OLT.pdb
glycoprot = combine { prot glycan }
savepdb glycoprot prebond_prot.pdb

bond glycoprot.1.OG1 glycoprot.1101.C1 

impose glycoprot {1} { {CB OG1 C1 H1 126} }

remove glycoprot glycoprot.1098
remove glycoprot glycoprot.1099
remove glycoprot glycoprot.1100

saveamberparm glycoprot prot.prmtop prot.inpcrd 
savepdb glycoprot prot.pdb
quit
